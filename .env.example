# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, used by the reminder sender. Never expose.

# Your public URL (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google's own sign-in button, so the Google popup names your site instead of
# your-project.supabase.co. Use the same Client ID as in Supabase → Authentication → Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional — AI headlines and message drafts. Without it, good templates are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Push notifications to phones. Generate once with:  npm run vapid
# Paste the Public Key and Private Key below (and in Vercel).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional — email copies of reminders via resend.com. Without it, reminders are in-app + push only.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=hyve5 <onboarding@resend.dev>

# Any long random string. Protects /api/cron/reminders.
CRON_SECRET=
